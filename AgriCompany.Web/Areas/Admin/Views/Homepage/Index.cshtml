@model List<HomepageSlide>
@{
    ViewData["Title"] = "سلايدر الرئيسية";
    // Slides whose image is still a local /images/... path rather than a Cloudinary URL
    var localImageCount = Model.Count(s => !string.IsNullOrWhiteSpace(s.ImagePath) && s.ImagePath.StartsWith('/'));
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">سلايدر الصفحة الرئيسية</h3>
    <a asp-area="Admin" asp-controller="Homepage" asp-action="Create" class="btn btn-admin-primary rounded-pill px-4">
        <i class="fa-solid fa-plus"></i> إضافة سلايد
    </a>
</div>

@if (localImageCount > 0)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span>
            <i class="fa-solid fa-cloud-arrow-up"></i>
            فيه @localImageCount صورة في السلايدر لسه متخزنة على السيرفر ومش على Cloudinary.
        </span>
        <form asp-area="Admin" asp-controller="Homepage" asp-action="MoveImagesToCloudinary" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-warning rounded-pill px-3">
                <i class="fa-solid fa-cloud-arrow-up"></i> انقلها إلى Cloudinary
            </button>
        </form>
    </div>
}

<div class="admin-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>الصورة</th>
                    <th>العنوان</th>
                    <th>العنوان الفرعي</th>
                    <th>الحالة</th>
                    <th>الترتيب</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slide in Model)
                {
                    <tr>
                        <td><img src="@slide.ImagePath" class="thumb" /></td>
                        <td>@slide.TitleAr</td>
                        <td>@slide.SubtitleAr</td>
                        <td>
                            @if (slide.IsActive)
                            {
                                <span class="badge bg-success">مفعل</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">غير مفعل</span>
                            }
                        </td>
                        <td>@slide.DisplayOrder</td>
                        <td>
                            <a asp-area="Admin" asp-controller="Homepage" asp-action="Edit" asp-route-id="@slide.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-item-name="@slide.TitleAr" data-form-id="delete-form-@slide.Id"
                                    onclick="confirmDeleteEl(this)">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                            <form id="delete-form-@slide.Id" asp-area="Admin" asp-controller="Homepage" asp-action="Delete" asp-route-id="@slide.Id" method="post" class="d-none">
                                @Html.AntiForgeryToken()
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">لا توجد سلايدات بعد</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
