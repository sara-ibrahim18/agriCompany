@model ContactMessage
@{
    ViewData["Title"] = "تفاصيل الرسالة";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">تفاصيل الرسالة</h3>
    <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-solid fa-arrow-right"></i> رجوع
    </a>
</div>

<div class="admin-card">
    <div class="row mb-4">
        <div class="col-md-4">
            <small class="text-muted d-block">الاسم بالكامل</small>
            <strong>@Model.FullName</strong>
        </div>
        <div class="col-md-4">
            <small class="text-muted d-block">رقم الهاتف</small>
            <strong>@Model.Phone</strong>
        </div>
        <div class="col-md-4">
            <small class="text-muted d-block">البريد الإلكتروني</small>
            <strong>@(Model.Email ?? "-")</strong>
        </div>
    </div>

    <div class="mb-4">
        <small class="text-muted d-block">الموضوع</small>
        <strong>@Model.Subject</strong>
    </div>

    <div class="mb-4">
        <small class="text-muted d-block">الرسالة</small>
        <p class="mb-0" style="white-space:pre-line;">@Model.Message</p>
    </div>

    <div class="mb-4">
        <small class="text-muted d-block">تاريخ الإرسال</small>
        <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-whatsapp" target="_blank" rel="noopener"
           href="https://wa.me/@Model.Phone">
            <i class="fa-brands fa-whatsapp"></i> تواصل عبر واتساب
        </a>
        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <a class="btn btn-outline-primary" href="mailto:@Model.Email">
                <i class="fa-solid fa-envelope"></i> رد بالبريد الإلكتروني
            </a>
        }
    </div>
</div>
