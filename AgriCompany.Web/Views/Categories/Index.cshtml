@model List<Category>
@{
    ViewData["Title"] = "أقسام المنتجات";
    ViewData["MetaDescription"] = "تصفح جميع أقسام المنتجات الزراعية لدينا: " + string.Join("، ", Model.Take(6).Select(c => c.NameAr)) + " وأكثر.";
    ViewData["MetaKeywords"] = "أقسام المنتجات, " + string.Join(", ", Model.Select(c => c.NameAr));
}
<div class="page-header text-center">
    <div class="container">
        <h1>أقسام المنتجات</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                <li class="breadcrumb-item active">الأقسام</li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            @foreach (var cat in Model)
            {
                <div class="col-6 col-md-6 col-lg-4" data-aos="fade-up">
                    <a asp-controller="Products" asp-action="ByCategory" asp-route-slug="@cat.Slug" class="category-card d-block">
                        <img src="@(string.IsNullOrWhiteSpace(cat.ImagePath) ? "/images/placeholders/category.jpg" : cat.ImagePath)" alt="@cat.NameAr" />
                        <div class="overlay">
                            <h5>@cat.NameAr</h5>
                        </div>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(cat.Description))
                    {
                        <p class="text-muted small mt-2">@cat.Description</p>
                    }
                </div>
            }
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">لا توجد أقسام متاحة حاليًا</div>
        }
    </div>
</section>
