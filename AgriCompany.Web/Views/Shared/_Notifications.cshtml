@if (TempData["ContactSuccess"] != null)
{
    <script>document.addEventListener('DOMContentLoaded', function(){ showToast('success', @Html.Raw(Json.Serialize(TempData["ContactSuccess"]))); });</script>
}
@if (TempData["ContactError"] != null)
{
    <script>document.addEventListener('DOMContentLoaded', function(){ showToast('error', @Html.Raw(Json.Serialize(TempData["ContactError"]))); });</script>
}
