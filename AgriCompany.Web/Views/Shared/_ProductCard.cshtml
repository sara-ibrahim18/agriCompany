@model Product
@using AgriCompany.Web.Services
@inject ICompanyInfoService CompanyInfoService
@inject IWebsiteSettingService WebsiteSettingService
@{
    var company = await CompanyInfoService.GetAsync();
    var settings = await WebsiteSettingService.GetAsync();
    var mainImage = Model.MainImagePath ?? "/images/placeholders/product.jpg";
}
<div class="product-card">
    <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="product-img-wrap d-block">
        @if (Model.IsFeatured)
        {
            <span class="badge bg-warning text-dark badge-featured">مميز</span>
        }
        @if (!Model.IsAvailable)
        {
            <span class="badge bg-secondary badge-unavailable">غير متوفر</span>
        }
        <img src="@mainImage" alt="@Model.NameAr" loading="lazy" />
    </a>
    <div class="p-3">
      
        <h6 class="fw-bold mb-1">
            <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="text-dark">@Model.NameAr</a>
        </h6>
        <div class="text-muted small mb-2">@Model.Category?.NameAr</div>
        <div class="d-flex justify-content-between align-items-center">
            <span class="price">
                @if (Model.Sizes.Any())
                {
                    @Model.Sizes.Min(s => s.Price).ToString("N0")
                    @settings.CurrencySymbol
                }
                else
                {
                    <span class="text-muted">غير محدد</span>
                }
            </span>
            @if (Model.IsAvailable)
            {
                var availableSizes = Model.Sizes.Where(s => s.IsAvailable).OrderBy(s => s.DisplayOrder).ToList();
                if (availableSizes.Count > 1)
                {
                    <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug"
                       class="btn btn-success btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-cart-plus"></i> اختر الحجم
                    </a>
                }
                else
                {
                    var onlySize = availableSizes.FirstOrDefault();
                    <button type="button" class="btn btn-success btn-sm rounded-pill px-3"
                            data-name="@Model.NameAr"
                            data-code="@Model.Code"
                            data-size="@(onlySize?.SizeName ?? "")"
                            data-price="@((onlySize?.Price ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                            data-image="@mainImage"
                            data-url="@Url.Action("Details", "Products", new { slug = Model.Slug })"
                            data-currency="@settings.CurrencySymbol"
                            onclick="addToCart(this)">
                        <i class="fa-solid fa-cart-plus"></i> أضف للسلة
                    </button>
                }
            }
        </div>

    </div>
</div>
