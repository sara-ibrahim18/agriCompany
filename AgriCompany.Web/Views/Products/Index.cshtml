@model ProductListViewModel
@{
    var currentCategory = ViewBag.CurrentCategory as Category;
    ViewData["Title"] = currentCategory != null ? currentCategory.NameAr : "المنتجات";
    ViewData["MetaDescription"] = currentCategory != null
        ? (!string.IsNullOrWhiteSpace(currentCategory.Description)
            ? currentCategory.Description
            : $"تصفح منتجات قسم {currentCategory.NameAr} بأفضل جودة وأسعار، مع خدمة طلب سهلة عبر واتساب.")
        : "تصفح جميع منتجاتنا الزراعية من أسمدة ومبيدات ومستلزمات زراعية بأعلى جودة.";
    ViewData["MetaKeywords"] = currentCategory != null
        ? $"{currentCategory.NameAr}, منتجات زراعية, أسعار"
        : "منتجات زراعية, أسمدة, مبيدات, مستلزمات زراعية";

}
<div class="page-header text-center">
    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                <li class="breadcrumb-item active">@ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Filters -->
            <div class="col-lg-3">
                <div class="filter-card p-3 sticky-top" style="top:90px;">
                    <form method="get" asp-controller="Products" asp-action="Index">
                        <h6 class="fw-bold mb-3"><i class="fa-solid fa-filter"></i> البحث والفلترة</h6>

                        <div class="mb-3">
                            <label class="form-label small">بحث</label>
                            <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="اسم المنتج أو القسم..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">القسم</label>
                            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                                <option value="">كل الأقسام</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    if (Model.CategoryId == cat.Id)
                                    {
                                        <option value="@cat.Id" selected>@cat.NameAr</option>
                                    }
                                    else
                                    {
                                        <option value="@cat.Id">@cat.NameAr</option>
                                    }
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success w-100 rounded-pill">
                            <i class="fa-solid fa-search"></i> بحث
                        </button>
                    </form>
                </div>
            </div>

            <!-- Products grid -->
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">تم العثور على @Model.Products.TotalItems منتج</span>
                </div>

                @if (Model.Products.Items.Any())
                {
                    <div class="row g-4">
                        @foreach (var product in Model.Products.Items)
                        {
                            <div class="col-lg-4 col-md-6" data-aos="fade-up">
                                @await Html.PartialAsync("_ProductCard", product)
                            </div>
                        }
                    </div>

                    @if (Model.Products.TotalPages > 1)
                    {
                        <nav class="mt-5">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= Model.Products.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.Products.PageNumber ? "active" : "")">
                                        <a class="page-link" asp-controller="Products" asp-action="Index"
                                           asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId"
                                           asp-route-sortBy="@Model.SortBy" asp-route-page="@i">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-box-open text-muted" style="font-size:4rem;"></i>
                        <p class="text-muted mt-3">لا توجد منتجات مطابقة لبحثك</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
