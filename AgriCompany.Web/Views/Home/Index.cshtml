<!-- CTA -->
<section class="py-5 text-center text-white" style="background: linear-gradient(135deg, var(--primary-dark), var(--primary-color));">
    <div class="container" data-aos="zoom-in">
        <h2 class="fw-bold mb-3">هل لديك استفسار عن منتجاتنا؟</h2>
        <p class="mb-4">فريقنا جاهز لمساعدتك عبر واتساب على مدار الأسبوع</p>
        <a class="btn btn-whatsapp btn-lg rounded-pill px-5" target="_blank" rel="noopener"
           href="https://wa.me/@Model.Company?.WhatsAppNumber?text=@Uri.EscapeDataString("مرحبًا، أرغب في الاستفسار عن منتجاتكم")">
            <i class="fa-brands fa-whatsapp"></i> تواصل معنا الآن
        </a>
    </div>
</section>

@section Scripts {
    <script>
        new Swiper('.hero-swiper', {
            loop: true,
            autoplay: { delay: 5000 },
            pagination: { el: '.swiper-pagination', clickable: true },
            navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' }
        });
        new Swiper('.testimonials-swiper', {
            slidesPerView: 1,
            spaceBetween: 20,
            pagination: { el: '.swiper-pagination', clickable: true },
            breakpoints: {
                768: { slidesPerView: 2 },
                992: { slidesPerView: 3 }
            }
        });
    </script>
}
